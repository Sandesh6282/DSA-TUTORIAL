# 1. Google Gemini AI API Key (Required for AI Tutor Chatbot)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6I26SMitJulXX_HUoSF03mlizTem7YgLXw2NexJd-xv4w

# 2. Recruiter Portal Authentication
# Password required to log into Recruiter Mode (/recruiter)
RECRUITER_ACCESS_PASSWORD=Recruiter2026!

# Cryptographic signing secret for HTTP-only session tokens
SESSION_SECRET=generate_a_random_32_character_secret_here

# 3. Online Code Execution (Judge0 CE / RapidAPI) [OPTIONAL]
# If left blank, the application automatically uses the built-in isolated container execution service (Piston)
# with zero configuration required!
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_for_judge0_if_using_rapidapi
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
